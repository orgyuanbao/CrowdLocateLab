    "range_cv_reported": {
      "spec": {
        "consensus_trials": 0,
        "f_scale": 1.5,
        "gate_margin": 0.05,
        "log_bias_correction": true,
        "log_sd": 0.1,
        "loss": "soft_l1",
        "model": "cv_select",
        "residual": "range",
        "ridge": 0.05,
        "scale": "reported",
        "starts": 3,
        "trim_fraction": 0.0
      },
      "hypothesis": "距离域soft-L1观测交叉验证选择在discovery上同时满足：moving_outliers平均误差低于legacy_bic，static_clean平均误差不超过static_wls的1.10倍。",
      "mathematical_definition": "静态模型d_i=||x-a_i||，恒速模型d_i=||x+t_i v-a_i||；残差r_i=(d_i-y_i)/sigma_i。各模型最小化sum_i 2c^2(sqrt(1+(r_i/c)^2)-1)+lambda||v||^2，其中c=1.5，lambda=0.05，静态模型无速度罚项。按时间排序作三折交错观测验证，用所有留出观测的平均单位尺度soft-L1残差损失评分；仅当全部恒速训练折满足实现规定的可用性条件且CV_velocity<0.95 CV_static时选择恒速，否则选择静态。内折按实现使用一个普通起点，最终全数据使用三个起点重拟合；不截尾、不添加抽样初始化。该候选与legacy_bic的比较是完整方法比较，不能单独归因于门控。"
    },
    "log_cv_reported": {
      "spec": {
        "model": "cv_select",
        "residual": "log_range",
        "loss": "soft_l1",
        "scale": "reported",
        "f_scale": 1.5,
        "ridge": 0.05,
        "trim_fraction": 0.0,
        "consensus_trials": 0,
        "starts": 3,
        "gate_margin": 0.05,
        "log_bias_correction": true,
        "log_sd": 0.1
      },
      "hypothesis": "在discovery共同案例上，log_cv_reported的moving_outliers平均当前位置误差低于range_cv_reported，且static_clean平均误差不超过static_wls的1.10倍。",
      "mathematical_definition": "静态距离d_i=||x-a_i||，恒速距离d_i=||x+t_i v-a_i||。令ell_i=sqrt(log(1+(sigma_i/max(y_i,0.1))^2))，残差r_i=[log(max(d_i,0.1))-log(max(y_i,0.1))-0.1^2/2]/ell_i。最小化sum_i 2c^2(sqrt(1+(r_i/c)^2)-1)+lambda||v||^2，c=1.5，lambda=0.05；静态无速度罚项。时间排序后三折交错验证，以全部留出观测的平均单位尺度soft-L1残差损失评分；全部恒速训练折可用且CV_velocity<0.95 CV_static时选择恒速，否则静态。内折一个普通起点，最终三个起点全数据重拟合；无截尾或抽样初始化。与range_cv_reported仅改变残差选项，包括其规定的尺度和中心化；这不是纯对数变换的独立效应，也不构成精确混合噪声似然或无偏保证。"
    },
    "range_cv_constant": {
      "spec": {
